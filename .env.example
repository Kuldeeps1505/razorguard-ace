# ============================================================
# RazorGuard ACE — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development          # development | testing | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://razorguard:razorguard@localhost:5432/razorguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=30

# ── Razorpay (TEST MODE ONLY) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
RAZORPAY_MODE=test            # test | live  — NEVER set live without explicit confirmation

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=groq             # claude | openai | gemini | groq
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
LLM_MODEL_CLAUDE=claude-3-5-sonnet-20241022
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_GEMINI=gemini-2.5-flash
LLM_MODEL_GROQ=openai/gpt-oss-20b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Capability Security ───────────────────────────────────────
CAPABILITY_SIGNING_KEY=change-me-to-a-random-32-byte-hex-string
CAPABILITY_TTL_SECONDS=300    # 5 minutes — short-lived

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_PAYMENT_PER_MINUTE=10
RATE_LIMIT_AGENT_PER_MINUTE=60

# ── Worker / Celery ──────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9090
